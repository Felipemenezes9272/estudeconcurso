# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Importação de edital por IA (chave gratuita em aistudio.google.com/apikey).
# Só no servidor: NÃO use o prefixo NEXT_PUBLIC_.
GEMINI_API_KEY=sua-chave-do-gemini
# Opcional: troque o modelo se o padrão for descontinuado.
# GEMINI_MODEL=gemini-2.5-flash
